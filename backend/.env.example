# ── Database & Cache ─────────────────────────────────────────────────────────
DB_URL=postgres://kubepilot:kubepilot@localhost:5432/kubepilot?sslmode=disable
REDIS_URL=redis://localhost:6379

# ── HTTP Server ───────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info          # debug | info | warn | error

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production   # min 32 chars in production

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_INTERVAL_SECONDS=300          # registry + helm poll interval

# ── Headlamp integration ──────────────────────────────────────────────────────
HEADLAMP_URL=http://localhost:4466   # base URL of your Headlamp instance
TLS_INSECURE=false

# ── First-run bootstrap ───────────────────────────────────────────────────────
# If set and no users exist, an admin account is created on startup.
# Leave ADMIN_PASSWORD blank to auto-generate and print to stdout.
ADMIN_EMAIL=admin@kubepilot.local
ADMIN_PASSWORD=                      # leave blank to auto-generate
ADMIN_NAME=Administrator

# ── In-cluster auto-registration ─────────────────────────────────────────────
# Set IN_CLUSTER=true when running inside Kubernetes (the Helm chart sets this automatically).
# KubePilot will auto-register the local cluster using the pod's ServiceAccount token.
IN_CLUSTER=false
CLUSTER_NAME=local                   # display name for the auto-registered cluster
